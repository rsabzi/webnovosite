# ---- اعلان تلگرام (الزامی برای دریافت پیام‌های فرم‌های سایت) ----
# توکن ربات را از @BotFather بگیرید
TELEGRAM_BOT_TOKEN=   # مثال: 1234567890:AAE...
# آیدی عددی چت مقصد (خودتان یا گروه). چند مقصد را با کاما جدا کنید.
# آیدی عددی خود را از @userinfobot بگیرید.
TELEGRAM_CHAT_ID=

# ---- دیتابیس (اختیاری) ----
# اگر خالی باشد سایت کار می‌کند و پیام‌ها فقط به تلگرام می‌رود.
DATABASE_URL=

# ---- تحلیل هوش مصنوعی ابزار «تشخیص اتوماسیون» (اختیاری ولی توصیه‌شده) ----
# کلید Google AI Studio (Gemini API). فقط سمت سرور خوانده می‌شود و هرگز در
# باندل کلاینت قرار نمی‌گیرد. برای ساخت کلید: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# مدل مورد استفاده؛ اگر خالی باشد gemini-2.5-flash انتخاب می‌شود.
# مدل پیش‌فرض؛ اگر این را خالی بگذارید، کد خودش جدیدترین مدل متنی فلشِ
# در دسترس همین کلید را از فهرست مدل‌های گوگل پیدا می‌کند (توصیه‌شده).
GEMINI_MODEL=gemini-3.8-flash
# سطح تفکر مدل‌های نسل ۳: low | medium | high (پیش‌فرض: low برای پاسخ سریع‌تر)
GEMINI_THINKING_LEVEL=low
# آدرس پایه‌ی API گوگل (در حالت عادی نیازی به تغییر نیست؛ برای پروکسی/درگاه واسط).
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ---- وضعیت سایت ----
# آدرس کامل دامنه برای canonical، sitemap و تصاویر OG
NEXT_PUBLIC_SITE_URL=https://www.webnovo.ir

# ---- محافظت از مسیرهای مدیریتی ----
# برای مشاهده‌ی فهرست لیدها: GET /api/leads با هدر x-admin-token باید همین مقدار باشد.
# اگر خالی بماند، این مسیر به‌کل غیرفعال (۴۰۴) می‌شود.
LEADS_ADMIN_TOKEN=

# رمز عبور ورود به داشبورد مخفی آمار (/admin/analytics).
# اگر خالی باشد، از مقدار LEADS_ADMIN_TOKEN یا پیش‌فرض webnovo-admin-2026 استفاده می‌شود.
ADMIN_ANALYTICS_PASSWORD=
